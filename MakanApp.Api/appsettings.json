{
  "ConnectionStrings": {
    "MakanDatabase": ""
  },
  "Identity": {
    "Otp": {
      "LifetimeSeconds": 300,
      "ResendDelaySeconds": 30,
      "RateLimitWindowSeconds": 3600,
      "MaxRequestsPerWindow": 5,
      "MaxFailedAttempts": 5
    },
    "Session": {
      "LifetimeSeconds": 2592000
    }
  },
  "Storage": {
    "RootPath": "",
    "MaxFileSizeBytes": 10485760,
    "UnattachedLifetimeHours": 24,
    "AllowedContentTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "text/plain"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
